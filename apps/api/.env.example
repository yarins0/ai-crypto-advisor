# apps/api — copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Allowed browser origin for CORS. In production this is the Vercel URL.
WEB_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Database — MongoDB Atlas
# ---------------------------------------------------------------------------
# 1. Create a free account and an M0 (free) cluster: https://www.mongodb.com/cloud/atlas/register
# 2. Atlas console: https://cloud.mongodb.com/
# 3. Database Access -> Add New Database User (read/write on this database only).
# 4. Network Access -> Add IP Address -> Allow access from anywhere (0.0.0.0/0),
#    which Render needs because its outbound IPs are not fixed.
# 5. Clusters -> Connect -> Drivers -> copy the connection string, then replace
#    <password> with the real password and add the database name.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai_crypto_advisor?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# Auth secrets
# ---------------------------------------------------------------------------
# Generate each one separately:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Signs the access-token JWTs.
JWT_ACCESS_SECRET=
# Mixed into every refresh-token hash before storage, so read access to the
# database alone cannot match a captured token to its row. Not a JWT key.
REFRESH_TOKEN_PEPPER=
ACCESS_TOKEN_TTL=60m
REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Coin prices — CoinGecko
# ---------------------------------------------------------------------------
# The public API works with no key but rate-limits hard. A free "Demo" key
# raises the limit and is strongly recommended.
# Sign up, then Developer Dashboard -> Create Demo API Key:
#   https://www.coingecko.com/en/developers/dashboard
# Docs: https://docs.coingecko.com/reference/introduction
COINGECKO_API_KEY=

# ---------------------------------------------------------------------------
# AI insight — Hugging Face Inference
# ---------------------------------------------------------------------------
# 1. Create an account: https://huggingface.co/join
# 2. Access Tokens -> Create new token -> type "Read":
#      https://huggingface.co/settings/tokens
# 3. The token must have the "Make calls to Inference Providers" permission.
# Model catalogue and pricing: https://huggingface.co/docs/inference-providers
HF_TOKEN=
# Model id is env-configurable on purpose: free-tier models get deprecated.
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_BASE_URL=https://router.huggingface.co/v1
